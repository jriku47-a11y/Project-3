# ============================================================
# DevForge — optional settings
# ------------------------------------------------------------
# This project is a STATIC site. It needs no environment
# variables to run, and none of these are read at runtime by the
# shipped front-end: all content and the mail relay live in
# js/config.js.
#
# This file exists so the values are documented in one place and
# so nobody commits a real credential by accident. Copy it to
# .env only if you add a backend, and .env is already ignored by
# git.
#
#   cp .env.example .env
#
# NEVER put a real value in this file — it is committed.
# ============================================================

# ---------- mail relay (front-end, configured in js/config.js) ----
# Web3Forms access key. Safe to publish BY DESIGN: it can only
# submit a message to your inbox. Get one at
# https://app.web3forms.com/onboarding/create
WEB3FORMS_ACCESS_KEY=replace-with-your-access-key

# ---------- optional PHP backend (NOT used by the static build) ----
# Required only if you host this project somewhere that runs PHP
# and you prefer your own mail endpoint over the relay.
# See README section 8.
MAIL_TO=you@example.com
MAIL_FROM=website@yourdomain.tld

# Resend (https://resend.com) — pick ONE transport, never both.
RESEND_API_KEY=re_replace_with_your_resend_api_key

# Gmail SMTP — needs 2-Step Verification and an App password.
# Google Account -> Security -> 2-Step Verification -> App passwords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=replace_with_your_16_character_app_password

# ---------- optional database (future enhancement) -----------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=devforge
DB_USER=replace_me
DB_PASS=replace_me

# ---------- local development server (tools/serve.js) -------------
PORT=8080
